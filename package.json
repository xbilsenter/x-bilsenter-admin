{
  "name": "x-bilsenter-admin",
  "version": "1.0.0",
  "private": true,
  "description": "X Bilsenter AS – driftssystem (CRM)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "install:all": "npm install && npm install --prefix server && npm install --prefix client --include=dev",
    "install:vercel": "npm install && npm install --prefix client --include=dev",
    "dev": "concurrently \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "start": "npm run start --prefix server",
    "start:all": "concurrently -n admin,site -c blue,green \"npm start\" \"npm start --prefix ../x-bilsenter\"",
    "build": "npm run build --prefix client",
    "vercel-build": "npm run build --prefix client",
    "start:prod": "npm run build && NODE_ENV=production npm run start --prefix server",
    "migrate:export": "npm run migrate:export --prefix server",
    "migrate:import": "npm run migrate:import --prefix server",
    "migrate:uploads": "node scripts/migrate-uploads-to-storage.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.7",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "imapflow": "^1.4.7",
    "jsonwebtoken": "^9.0.2",
    "mailparser": "^3.9.14",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.17.2",
    "pg": "^8.22.0",
    "serverless-http": "^3.2.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.8.1"
  }
}
