PORT=8090
JWT_SECRET=xbilsenter-dev-jwt-secret-endre-i-prod
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
INGEST_SECRET=xbilsenter-ingest-dev-key
VEGVESEN_API_KEY=

# Valgfritt – AI-visjon for chassisnummer fra bilde (anbefalt for presis OCR)
# OPENAI_API_KEY=
# OPENAI_VISION_MODEL=gpt-4o-mini

# Skatteetaten – omregistreringsavgift (Maskinporten)
# Krever tilgang til scope skatteetaten:omregistreringsavgift og rettighetspakke fra Skatteetaten.
# Test: MASKINPORTEN_TOKEN_URL=https://test.maskinporten.no/token
#       SKATTEETATEN_OMREG_API_BASE=https://api-test.sits.no/api/omregistreringsavgift/v1
MASKINPORTEN_CLIENT_ID=
MASKINPORTEN_PRIVATE_KEY=
# Alternativt: MASKINPORTEN_PRIVATE_KEY_PATH=/path/to/private-key.pem
# MASKINPORTEN_KEY_ID=
# MASKINPORTEN_TOKEN_URL=https://maskinporten.no/token
SKATTEETATEN_OMREG_RETTIGHETSPAKKE=
# SKATTEETATEN_OMREG_API_BASE=https://api.skatteetaten.no/api/omregistreringsavgift/v1
# SKATTEETATEN_OMREG_CONSUMER_ORG=
PUBLIC_SITE_ORIGIN=http://localhost:8080
ADMIN_PUBLIC_URL=http://localhost:8090
# Kommaseparert liste for ekstra CORS-origins (Vercel-produksjon)
# CORS_ORIGINS=https://xbilsenter.no,https://www.xbilsenter.no
# ADMIN_PUBLIC_URL=https://drift.xbilsenter.no

# Vercel cron (e-postsync) – generer: openssl rand -hex 32
# CRON_SECRET=

# E-post (valgfritt – kan også settes under Innstillinger → E-postkontoer)
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_FROM_NAME=X Bilsenter AS

# Supabase (valgfritt – sky-database)
# USE_SUPABASE=false
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=
# SUPABASE_STORAGE_BUCKET=uploads
