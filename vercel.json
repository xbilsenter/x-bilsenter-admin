{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm run install:vercel",
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "client/dist",
  "framework": null,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "x-bilsenter-admin.vercel.app" }],
      "destination": "https://drift.xbilsenter.no/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/api/ping", "destination": "/api/ping" },
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/uploads/(.*)", "destination": "/api" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 300,
      "memory": 1024,
      "includeFiles": "server/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron/mail-sync",
      "schedule": "* * * * *"
    }
  ]
}
